    <edge source="COGNITIVE DYSFUNCTION" target="ESSENTIAL WORKER STATUS">
      <data key="d7">COGNITIVE FUNCTION</data>
      <data key="d8">ESSENTIAL WORKER STATUS</data>
      <data key="d9">MODULATED_BY_EXPOSURE</data>
      <data key="d10">Essential workers are identified as a group that could benefit from early neuropsychological testing to evaluate post-COVID impairment and its impact on return to everyday activities.</data>
      <data key="d11">0.58</data>
      <data key="d12">3</data>
