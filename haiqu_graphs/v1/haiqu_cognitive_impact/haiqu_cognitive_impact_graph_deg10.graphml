      <data key="d6">NEUROPSYCHOLOGICAL TESTING,NEUROPSYCHOLOGICAL TESTS</data>
    </node>
    <node id="IMMEDIATE WORD RECALL">
      <data key="d0">IMMEDIATE WORD RECALL</data>
      <data key="d1">NEUROPSYCH_TEST</data>
      <data key="d2">A neuropsychological test used in the study as an operational measure of memory deficits. It is specifically described as mediating the relationship between policy implementation and depression.</data>
      <data key="d3">0.86</data>
