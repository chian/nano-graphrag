      <data key="d7">SARS-COV-2 INFECTION</data>
      <data key="d8">WORKING MEMORY</data>
      <data key="d9">AFFECTS</data>
      <data key="d10">A related article title links neurological post-COVID syndrome with substantial impairment of working memory, suggesting this domain may be affected in post-SARS-CoV-2 conditions.</data>
      <data key="d11">0.6</data>
      <data key="d12">2</data>
      <data key="d13">86f9ab26-f1be-4c98-8916-d978196e27f5_chunk_1</data>
      <data key="d14">86f9ab26-f1be-4c98-8916-d978196e27f5</data>
    </edge>
