    <node id="SYMPTOMATIC SARS-COV-2 INFECTION">
      <data key="d0">SYMPTOMATIC SARS-COV-2 INFECTION</data>
      <data key="d1">DISEASE_SEVERITY</data>
      <data key="d2">SARS-CoV-2 infection accompanied by symptoms. In the abstract, previous symptomatic infection was associated with poorer quality of life, impairment across daily activities, and multiple persistent symptoms including confusion.</data>
      <data key="d3">0.92</data>
      <data key="d4">12c7acb8-2413-4c1d-abe2-05572985c5f1_chunk_0,12c7acb8-2413-4c1d-abe2-05572985c5f1_chunk_16,12c7acb8-2413-4c1d-abe2-05572985c5f1_chunk_18</data>
