      <data key="d7">SUBJECTIVE COGNITIVE FUNCTIONING</data>
      <data key="d8">SOCIAL ISOLATION</data>
      <data key="d9">CONFOUNDED_BY</data>
      <data key="d10">Because social isolation can negatively affect cognitive functioning, it may partially explain perceived cognitive changes attributed to the pandemic.</data>
      <data key="d11">0.73</data>
      <data key="d12">2</data>
      <data key="d13">9ac1c295-0116-47ef-a0b9-9e8531f02406_chunk_2</data>
      <data key="d14">9ac1c295-0116-47ef-a0b9-9e8531f02406</data>
    </edge>
