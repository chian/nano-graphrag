    <node id="NEURONAL APOPTOSIS">
      <data key="d0">NEURONAL APOPTOSIS</data>
      <data key="d1">BIOLOGICAL_MECHANISM</data>
      <data key="d2">Programmed neuronal cell death associated with dysregulation of the glutamate/GABA neurotransmitter system. | Programmed neuronal cell death identified as a targetable mechanism after traumatic spinal cord injury.</data>
