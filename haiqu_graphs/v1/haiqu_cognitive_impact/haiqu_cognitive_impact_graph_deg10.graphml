      <data key="d8">INSOMNIA</data>
      <data key="d9">CONFOUNDED_BY</data>
      <data key="d10">Sleep disturbance can independently worsen cognitive function and was assessed as a Long COVID symptom.</data>
      <data key="d11">0.58</data>
