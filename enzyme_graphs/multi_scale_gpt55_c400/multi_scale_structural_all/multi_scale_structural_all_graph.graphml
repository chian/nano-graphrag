  <data key="d9">MVAP DECARBOXYLATION ACTIVITY</data>
  <data key="d10">MEASURED_BY</data>
  <data key="d11">Growth rate is used as the phenotypic readout for comparing MVAP decarboxylation activity among PMDsc variants.</data>
  <data key="d12">0.87</data>
  <data key="d13">2</data>
  <data key="d14">8b12a598-340d-5340-aebf-b31ea016d294_chunk_3</data>
  <data key="d15">8b12a598-340d-5340-aebf-b31ea016d294</data>
</edge>
