  <data key="d10">SUPPORTED_BY</data>
  <data key="d11">OD600 reduction supports the conclusion that DH1 is highly susceptible to fosmidomycin-induced growth inhibition and cell death.</data>
  <data key="d12">0.78</data>
  <data key="d13">1</data>
  <data key="d14">8b12a598-340d-5340-aebf-b31ea016d294_chunk_3</data>
  <data key="d15">8b12a598-340d-5340-aebf-b31ea016d294</data>
</edge>
