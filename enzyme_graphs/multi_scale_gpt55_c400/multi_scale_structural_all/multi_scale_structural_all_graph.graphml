  <data key="d0">REFINED COORDINATES AND STRUCTURE FACTORS</data>
  <data key="d1">EVIDENCE</data>
  <data key="d2">Deposited crystallographic model and diffraction-derived data for PDB entries 4DPT, 4DPU, 4DPW, 4DPX, 4DPY, 4DU7, and 4DU8.</data>
  <data key="d3">0.82</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_12</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
