  <data key="d0">S192A LACK OF P-LOOP MOVEMENT</data>
  <data key="d1">DYNAMICAL_STATE</data>
  <data key="d2">Conformational state in S192A MDD where expected P-loop movement toward the active site is absent.</data>
  <data key="d3">0.88</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_9</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
