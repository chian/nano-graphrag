  <data key="d8">PMD KINETIC PARAMETERS</data>
  <data key="d9">PMD KINETIC COMPARISON CONTEXT</data>
  <data key="d10">CONTEXT_DEPENDENT_ON</data>
  <data key="d11">Interpretation of the PMD kinetic parameters depends on the stated comparison among PMD wild type, PMDsc mutants, PMDse, and PMDhv.</data>
  <data key="d12">0.82</data>
  <data key="d13">1</data>
  <data key="d14">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_17</data>
  <data key="d15">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</edge>
