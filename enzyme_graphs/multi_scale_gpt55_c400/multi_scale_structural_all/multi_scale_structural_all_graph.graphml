  <data key="d8">GROWTH RECOVERY UNDER FOSMIDOMYCIN</data>
  <data key="d9">TAIPK</data>
  <data key="d10">SUPPORTED_BY</data>
  <data key="d11">Observed DH1 growth recovery supports functional TaIPK activity in the pathway.</data>
  <data key="d12">0.76</data>
  <data key="d13">3</data>
  <data key="d14">8b12a598-340d-5340-aebf-b31ea016d294_chunk_3</data>
  <data key="d15">8b12a598-340d-5340-aebf-b31ea016d294</data>
</edge>
<edge source="NO GROWTH WITH INACTIVE PMDSC-S208E" target="MVAP DECARBOXYLATION BY PMDSC">
  <data key="d8">NO GROWTH WITH INACTIVE PMDSC-S208E</data>
  <data key="d9">MVAP DECARBOXYLATION BY PMDSC</data>
  <data key="d10">SUPPORTED_BY</data>
  <data key="d11">Failure of S208E-expressing strains to grow supports the requirement for PMDsc-catalyzed MVAP decarboxylation.</data>
  <data key="d12">0.9</data>
  <data key="d13">3</data>
  <data key="d14">8b12a598-340d-5340-aebf-b31ea016d294_chunk_3</data>
  <data key="d15">8b12a598-340d-5340-aebf-b31ea016d294</data>
</edge>
<edge source="NO GROWTH WITH INACTIVE PMDSC-S208E" target="IPP-BYPASS PATHWAYS">
  <data key="d8">NO GROWTH WITH INACTIVE PMDSC-S208E</data>
  <data key="d9">IPP-BYPASS MVA PATHWAY</data>
  <data key="d10">EXPLAINS</data>
  <data key="d11">The no-growth phenotype with inactive PMDsc explains that cellular growth is dependent on the functional decarboxylation step within the heterologous pathway.</data>
  <data key="d12">0.84</data>
  <data key="d13">3</data>
  <data key="d14">8b12a598-340d-5340-aebf-b31ea016d294_chunk_3</data>
  <data key="d15">8b12a598-340d-5340-aebf-b31ea016d294</data>
</edge>
