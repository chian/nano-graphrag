  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_5</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
<node id="GLU69">
  <data key="d0">GLU69</data>
  <data key="d1">RESIDUE</data>
  <data key="d2">Nonconserved MDD residue whose side chain interacts with the ribose 2'-hydroxyl group of ATPγS.</data>
  <data key="d3">0.68</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_5</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
