</node>
<node id="IPP HYDROLYSIS TO ISOPENTENOL">
  <data key="d0">IPP HYDROLYSIS TO ISOPENTENOL</data>
  <data key="d1">REACTION_STEP</data>
  <data key="d2">Conversion of isopentenyl diphosphate into isopentenol by phosphatases such as NudF from Bacillus subtilis or NudB from E. coli.</data>
  <data key="d3">0.9</data>
  <data key="d4">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_1</data>
  <data key="d5">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
