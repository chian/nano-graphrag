  <data key="d8">S192A MDD MUTANT</data>
  <data key="d9">SUBSTRATE-BINDING KM</data>
  <data key="d10">CONSTRAINS</data>
  <data key="d11">The S192A mutation leaves KM near wild-type values, constraining the inferred role of Ser192 to catalysis rather than substrate binding.</data>
  <data key="d12">0.74</data>
  <data key="d13">1</data>
  <data key="d14">a9c7009e-9e90-565c-abe8-c021976be257_chunk_5</data>
  <data key="d15">a9c7009e-9e90-565c-abe8-c021976be257</data>
</edge>
