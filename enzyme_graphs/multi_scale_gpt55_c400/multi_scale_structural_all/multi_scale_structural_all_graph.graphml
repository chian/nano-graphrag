</node>
<node id="SO4^2-">
  <data key="d0">SO4^2-</data>
  <data key="d1">CONTEXT</data>
  <data key="d2">Sulfate anion present in the reported MDD_EF complex. It contributes to the crystallographic anion-binding environment and may occupy a phosphate-like binding region.</data>
  <data key="d3">0.66</data>
  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_17</data>
  <data key="d5">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
</node>
