  <data key="d0">KCAT/KM FOR MVAP</data>
  <data key="d1">KINETIC_PARAMETER</data>
  <data key="d2">Catalytic efficiency parameter for MVAP decarboxylation, reflecting kinetic steps associated with substrate and cofactor binding as well as catalysis.</data>
  <data key="d3">1.0</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_9</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
