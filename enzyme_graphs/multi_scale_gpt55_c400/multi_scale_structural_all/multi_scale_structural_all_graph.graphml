<edge source="GROWTH RECOVERY UNDER FOSMIDOMYCIN" target="MTIPK">
  <data key="d8">GROWTH RECOVERY UNDER FOSMIDOMYCIN</data>
  <data key="d9">MTIPK</data>
  <data key="d10">SUPPORTED_BY</data>
  <data key="d11">The observed shorter lag phase and recovery of DH1 growth support MtIPK as the better kinase choice for the screening platform.</data>
  <data key="d12">0.82</data>
  <data key="d13">3</data>
  <data key="d14">8b12a598-340d-5340-aebf-b31ea016d294_chunk_3</data>
  <data key="d15">8b12a598-340d-5340-aebf-b31ea016d294</data>
</edge>
