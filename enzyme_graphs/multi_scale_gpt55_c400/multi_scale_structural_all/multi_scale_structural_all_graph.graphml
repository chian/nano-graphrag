  <data key="d0">PMDSC KINETIC PARAMETERS</data>
  <data key="d1">KINETIC_PARAMETER</data>
  <data key="d2">In vitro kinetic measurements for PMDsc mutants, including kcat, KM, and kcat/KM, used to evaluate activity toward MVAP.</data>
  <data key="d3">0.88</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_8</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
