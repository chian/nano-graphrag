  <data key="d9">IPP-BYPASS MVA PATHWAY</data>
  <data key="d10">PART_OF</data>
  <data key="d11">MVAP decarboxylation to IP is a key noncanonical step in the IPP-bypass MVA pathway.</data>
  <data key="d12">0.98</data>
  <data key="d13">1</data>
  <data key="d14">8b12a598-340d-5340-aebf-b31ea016d294_chunk_2</data>
  <data key="d15">8b12a598-340d-5340-aebf-b31ea016d294</data>
</edge>
