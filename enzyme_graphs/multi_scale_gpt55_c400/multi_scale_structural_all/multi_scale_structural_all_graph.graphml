  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_17</data>
  <data key="d5">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
</node>
<node id="DECARBOXYLASE ACTIVITY">
  <data key="d0">DECARBOXYLASE ACTIVITY</data>
  <data key="d1">REACTION_STEP</data>
  <data key="d2">The native catalytic reaction of mevalonate diphosphate decarboxylase, involving decarboxylation of a diphosphomevalonate-related substrate to support isoprenoid-pathway chemistry.</data>
