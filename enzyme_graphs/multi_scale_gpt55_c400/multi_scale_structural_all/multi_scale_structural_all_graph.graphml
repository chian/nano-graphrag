  <data key="d9">ATP BINDING</data>
  <data key="d10">COUPLES_TO</data>
  <data key="d11">The substrate binding order is coupled to ATP binding because substrate occupancy and nucleotide association are linked in the catalytic cycle.</data>
  <data key="d12">0.75</data>
  <data key="d13">2</data>
  <data key="d14">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_17</data>
