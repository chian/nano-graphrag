<edge source="BALANCED EXPRESSION OF MVA PATHWAY ENZYMES" target="ACCUMULATION OF TOXIC MVA-PATHWAY INTERMEDIATES">
  <data key="d8">BALANCED EXPRESSION OF MVA PATHWAY ENZYMES</data>
  <data key="d9">ACCUMULATION OF TOXIC MVA-PATHWAY INTERMEDIATES</data>
  <data key="d10">CONSTRAINS</data>
  <data key="d11">Balancing pathway enzyme expression minimizes accumulation of toxic intermediates such as IPP, FPP, and HMG-CoA.</data>
  <data key="d12">0.85</data>
  <data key="d13">1</data>
  <data key="d14">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_1</data>
