  <data key="d0">ATP-BOUND CLOSED P-LOOP STATE</data>
  <data key="d1">DYNAMICAL_STATE</data>
  <data key="d2">Closed conformational state of the P-loop formed after ATP binding, enabling catalytic coordination of substrate and cofactor.</data>
  <data key="d3">0.85</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_9</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
<node id="SUBSTRATE AND COFACTOR COORDINATION">
  <data key="d0">SUBSTRATE AND COFACTOR COORDINATION</data>
  <data key="d1">REACTION_STEP</data>
  <data key="d2">Catalytic organization step in which the closed P-loop coordinates MVAP and ATP-derived cofactor interactions for decarboxylation.</data>
  <data key="d3">0.8</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_9</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
