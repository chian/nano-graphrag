  <data key="d2">Experimental assay measuring activities of WT, R74G, V230E, R74G-R147K-M212Q, and R74H-R147K-M212Q across MVAP concentrations up to 100 mM, with activities normalized to fitted kcat values.</data>
  <data key="d3">0.9</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_10</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
