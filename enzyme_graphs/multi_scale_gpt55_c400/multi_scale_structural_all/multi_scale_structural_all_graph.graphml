  <data key="d1">CONTEXT</data>
  <data key="d2">Crystallographic packing context in which crystals belonging to space group P212121 contained eight copies of MDD in the asymmetric unit.</data>
  <data key="d3">0.55</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_4</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
