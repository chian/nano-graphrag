  <data key="d1">EVIDENCE</data>
  <data key="d2">Cobalt-bound MDDEF structural model containing MVAPP, ADP, SO42−, and Co2+, used to identify two active-site cobalt positions. | Structural model of MDDEF in complex with MVAPP, ADP, sulfate, and cobalt, used as the basis for secondary-structure annotation.</data>
  <data key="d3">0.96</data>
  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_5</data>
  <data key="d5">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
  <data key="d6">0.96</data>
  <data key="d7">MDDEF-MVAPP-ADP-SO4-CO2+ STRUCTURAL MODEL</data>
</node>
