  <data key="d0">ACTIVE-SITE CΑ-DISTANCE SUPERPOSITION</data>
  <data key="d1">EVIDENCE</data>
  <data key="d2">Structural comparison of ternary MDD complexes using distances measured from equivalent active-site amino acid Cα atoms with PyMOL.</data>
  <data key="d3">0.66</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_8</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
