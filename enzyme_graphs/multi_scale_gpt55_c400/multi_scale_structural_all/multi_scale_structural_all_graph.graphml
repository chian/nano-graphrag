  <data key="d0">PMDSC MUTANT PANEL</data>
  <data key="d1">CONTEXT</data>
  <data key="d2">Collection of characterized PMDsc variants evaluated for MVAP decarboxylation kinetics, cellular growth rate, and isopentenol production.</data>
  <data key="d3">0.9</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_9</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
