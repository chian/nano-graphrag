  <data key="d0">INITIAL FO-FC MAPS</data>
  <data key="d1">EVIDENCE</data>
  <data key="d2">Initial difference electron-density maps inspected after refinement. These maps revealed unmodeled contiguous density corresponding to ordered ligands in MDD active sites.</data>
  <data key="d3">0.84</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_4</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
<node id="2.19 Å WT MDD-FMVAPP-ATPΓS COCRYSTAL STRUCTURE">
