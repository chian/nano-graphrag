  <data key="d1">DYNAMICAL_STATE</data>
  <data key="d2">Mutant-specific displacement of the β-sheet 9–helix 5 loop away from the active site in S192A MDD.</data>
  <data key="d3">0.86</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_9</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
