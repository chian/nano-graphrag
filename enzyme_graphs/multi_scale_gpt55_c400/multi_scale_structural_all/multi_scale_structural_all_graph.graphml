  <data key="d0">ENZYMOLOGY</data>
  <data key="d1">EVIDENCE</data>
  <data key="d2">Experimental enzymatic characterization performed on purified wild-type and K187A MDD protein samples.</data>
  <data key="d3">0.52</data>
  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_21</data>
  <data key="d5">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
