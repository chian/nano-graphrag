  <data key="d4">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_7</data>
  <data key="d5">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</node>
<node id="CONSERVED CATALYTIC AND BINDING RESIDUES IN PMD">
  <data key="d0">CONSERVED CATALYTIC AND BINDING RESIDUES IN PMD</data>
  <data key="d1">SEQUENCE_FEATURE</data>
  <data key="d2">Residues conserved between PMDsc and PMDse, identified by sequence alignment, implicated in catalysis and substrate binding.</data>
  <data key="d3">0.76</data>
  <data key="d4">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_7</data>
  <data key="d5">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</node>
<node id="PMDSE R193">
  <data key="d0">PMDSE R193</data>
