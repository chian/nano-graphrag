<node id="NUDB OR NUDF PHOSPHATASE ACTIVITY">
  <data key="d0">NUDB OR NUDF PHOSPHATASE ACTIVITY</data>
  <data key="d1">REACTION_STEP</data>
  <data key="d2">Phosphatase-catalyzed removal of diphosphate from IPP, enabling formation of isopentenol in the engineered pathway.</data>
  <data key="d3">0.82</data>
  <data key="d4">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_1</data>
  <data key="d5">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
