  <data key="d8">PMDSC LOWER MVAPP SPECIFICITY PROFILE</data>
  <data key="d9">PMDSC KCAT/KM FOR MVAPP</data>
  <data key="d10">MEASURED_BY</data>
  <data key="d11">PMDsc's lower native-substrate specificity is reflected by its reported kcat/Km of 4.0 × 10^4 s^-1 M^-1.</data>
  <data key="d12">0.78</data>
  <data key="d13">1</data>
  <data key="d14">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_7</data>
  <data key="d15">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</edge>
