  <data key="d10">SUPPORTED_BY</data>
  <data key="d11">The reduced kcat of the S192A mutant supports the catalytic importance of Ser192.</data>
  <data key="d12">0.82</data>
  <data key="d13">2</data>
  <data key="d14">a9c7009e-9e90-565c-abe8-c021976be257_chunk_5</data>
