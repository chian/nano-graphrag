  <data key="d1">POCKET_GEOMETRY</data>
  <data key="d2">Proposed more compact active-site arrangement needed because MVAP lacks the beta-phosphate group, reducing packing defects during binding.</data>
  <data key="d3">0.85</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_9</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
