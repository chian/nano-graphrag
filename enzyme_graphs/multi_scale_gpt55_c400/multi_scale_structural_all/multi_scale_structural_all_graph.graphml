  <data key="d10">CONSTRAINS</data>
  <data key="d11">The funnel-like active-site geometry constrains substrate access, favoring acceptor binding before ATP.</data>
  <data key="d12">0.92</data>
  <data key="d13">1</data>
  <data key="d14">a9c7009e-9e90-565c-abe8-c021976be257_chunk_10</data>
  <data key="d15">a9c7009e-9e90-565c-abe8-c021976be257</data>
</edge>
