  <data key="d8">PMD RATE-LIMITING STEP</data>
  <data key="d9">ISOPENTENOL PRODUCTIVITY</data>
  <data key="d10">GATES</data>
  <data key="d11">The PMD bottleneck gates overall pathway throughput and constrains productivity.</data>
  <data key="d12">0.85</data>
  <data key="d13">1</data>
  <data key="d14">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_12</data>
  <data key="d15">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</edge>
