  <data key="d8">PMD RATE-LIMITING STEP</data>
  <data key="d9">ISOPENTENOL YIELD</data>
  <data key="d10">GATES</data>
  <data key="d11">Because PMD activity is rate-limiting, it controls potential improvement in isopentenol yield.</data>
  <data key="d12">0.86</data>
  <data key="d13">1</data>
  <data key="d14">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_12</data>
  <data key="d15">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</edge>
