  <data key="d9">CATALYTIC TURNOVER KCAT</data>
  <data key="d10">DETERMINES</data>
  <data key="d11">Replacing Ser192 with alanine causes a greater than 10-fold decrease in kcat.</data>
  <data key="d12">0.86</data>
  <data key="d13">1</data>
  <data key="d14">a9c7009e-9e90-565c-abe8-c021976be257_chunk_5</data>
