  <data key="d8">APHA BYPASS ACTIVITY</data>
  <data key="d9">ISOPENTENOL TITERS</data>
  <data key="d10">ALLOWS</data>
  <data key="d11">The newly implemented AphA activity contributes to the pathway-II route that achieved considerable isopentenol titers.</data>
  <data key="d12">0.78</data>
  <data key="d13">1</data>
  <data key="d14">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_12</data>
  <data key="d15">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</edge>
<edge source="PMD RATE-LIMITING STEP" target="ATP-SAVING IPP-BYPASS PATHWAY II">
  <data key="d8">PMD RATE-LIMITING STEP</data>
  <data key="d9">ATP-SAVING IPP-BYPASS PATHWAY II</data>
  <data key="d10">PART_OF</data>
  <data key="d11">The rate-limiting PMD step is part of the bypass pathway architecture and limits its throughput.</data>
  <data key="d12">0.8</data>
  <data key="d13">1</data>
  <data key="d14">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_12</data>
  <data key="d15">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</edge>
