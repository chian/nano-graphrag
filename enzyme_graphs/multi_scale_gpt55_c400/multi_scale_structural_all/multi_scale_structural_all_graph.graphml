  <data key="d0">PMD NATIVE MVAPP REACTION</data>
  <data key="d1">REACTION_STEP</data>
  <data key="d2">Native PMD reaction involving mevalonate diphosphate (MVAPP), the physiological substrate used to infer substrate-binding determinants.</data>
  <data key="d3">0.82</data>
  <data key="d4">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_7</data>
  <data key="d5">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</node>
