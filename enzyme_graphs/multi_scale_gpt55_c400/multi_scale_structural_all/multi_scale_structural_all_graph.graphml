  <data key="d4">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_1</data>
  <data key="d5">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</node>
<node id="ISOPENTENOL PRODUCTION">
  <data key="d0">ISOPENTENOL PRODUCTION</data>
  <data key="d1">CONTEXT</data>
  <data key="d2">Target bioproduction process discussed in the text, initially dependent on IPP formation and hydrolysis but later redesigned through IPP-bypass routes.</data>
  <data key="d3">0.95</data>
  <data key="d4">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_1,dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_15</data>
