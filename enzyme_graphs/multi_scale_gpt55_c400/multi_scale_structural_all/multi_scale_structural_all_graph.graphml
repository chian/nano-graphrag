  <data key="d1">EVIDENCE</data>
  <data key="d2">Reference [2], a Nature article discussing microbial engineering strategies for advanced biofuel production.</data>
  <data key="d3">0.76</data>
  <data key="d4">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_13</data>
  <data key="d5">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
