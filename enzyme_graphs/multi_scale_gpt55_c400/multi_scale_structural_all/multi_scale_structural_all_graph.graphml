  <data key="d8">IPP-BYPASS PATHWAY I</data>
  <data key="d9">ENGINEERED E. COLI ISOPENTENOL PRODUCTION CONTEXT</data>
  <data key="d10">CONTEXT_DEPENDENT_ON</data>
  <data key="d11">Pathway I was proposed for construction and expression in engineered E. coli. | Pathway II was proposed for construction and expression in engineered E. coli.</data>
  <data key="d12">0.76</data>
  <data key="d13">1</data>
  <data key="d14">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_4</data>
  <data key="d15">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</edge>
