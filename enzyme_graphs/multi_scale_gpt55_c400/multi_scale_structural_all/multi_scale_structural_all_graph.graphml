  <data key="d0">ACTIVE-SITE POCKET OF MDD_EF</data>
  <data key="d1">POCKET_GEOMETRY</data>
  <data key="d2">Catalytic pocket in and around which ligand-dependent conformational rearrangements occur during the MDD_EF reaction cycle.</data>
  <data key="d3">0.92</data>
  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_2</data>
  <data key="d5">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
</node>
