  <data key="d0">ENZYMATIC EXPERIMENTS</data>
  <data key="d1">EVIDENCE</data>
  <data key="d2">Functional assays used to determine MDDEF kinetic parameters under cobalt-substituted conditions and confirm that cobalt can substitute for magnesium.</data>
  <data key="d3">0.87</data>
  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_5</data>
  <data key="d5">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
</node>
