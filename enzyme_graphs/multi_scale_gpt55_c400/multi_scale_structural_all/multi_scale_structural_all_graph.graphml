<node id="SER-CAT BEAMLINES AT THE ADVANCED PHOTON SOURCE">
  <data key="d0">SER-CAT BEAMLINES AT THE ADVANCED PHOTON SOURCE</data>
  <data key="d1">CONTEXT</data>
  <data key="d2">Synchrotron beamline setting where the X-ray diffraction data were collected.</data>
  <data key="d3">0.56</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_12</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
<node id="MEVALONATE PATHWAY ENZYMES">
  <data key="d0">MEVALONATE PATHWAY ENZYMES</data>
  <data key="d1">CONTEXT</data>
  <data key="d2">Target enzyme class proposed for antimicrobial inhibitor development. The excerpt states that these enzymes have not yet been targeted for antibiotic purposes.</data>
  <data key="d3">0.84</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_12</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
