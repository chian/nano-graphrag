<node id="MEVALONATE 5-DIPHOSPHATE (MVAPP)">
  <data key="d0">MEVALONATE 5-DIPHOSPHATE (MVAPP)</data>
  <data key="d1">CONTEXT</data>
  <data key="d2">MDD substrate prepared as described previously and relevant to substrate-binding and ligand-cocrystallization contexts.</data>
  <data key="d3">0.66</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_3</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
<node id="6-FLUOROMEVALONATE DIPHOSPHATE (FMVAPP)">
  <data key="d0">6-FLUOROMEVALONATE DIPHOSPHATE (FMVAPP)</data>
  <data key="d1">CONTEXT</data>
  <data key="d2">Fluorinated mevalonate diphosphate analogue prepared by a published method and relevant to MDD ligand studies.</data>
  <data key="d3">0.61</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_3</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
