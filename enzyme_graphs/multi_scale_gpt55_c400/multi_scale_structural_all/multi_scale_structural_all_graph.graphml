  <data key="d0">ATPΓS Γ-PHOSPHORYL INTERACTION STATE</data>
  <data key="d1">DYNAMICAL_STATE</data>
  <data key="d2">Binding state in which the γ-phosphoryl group of ATPγS is contacted by conserved Lys188 in the D283A ternary structure.</data>
  <data key="d3">0.82</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_8</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
