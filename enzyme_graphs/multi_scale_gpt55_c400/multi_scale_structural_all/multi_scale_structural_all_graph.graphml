  <data key="d9">IPP ACCUMULATION BURDEN</data>
  <data key="d10">ALLOWS</data>
  <data key="d11">The bypass design allows production without the burden attributed to IPP accumulation.</data>
  <data key="d12">0.79</data>
  <data key="d13">2</data>
  <data key="d14">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_11</data>
  <data key="d15">dd599823-57fe-59b5-bf71-6ef7c22b4a8a</data>
</edge>
