  <data key="d1">POCKET_GEOMETRY</data>
  <data key="d2">Acceptor substrate site in D283A MDD that is largely similar to wild type but displays altered MVAPP carboxylate and C3-hydroxyl orientation.</data>
  <data key="d3">0.84</data>
  <data key="d4">a9c7009e-9e90-565c-abe8-c021976be257_chunk_8</data>
  <data key="d5">a9c7009e-9e90-565c-abe8-c021976be257</data>
</node>
