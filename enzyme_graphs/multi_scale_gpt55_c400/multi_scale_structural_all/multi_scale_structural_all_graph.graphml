  <data key="d0">MVAP-ATP STABILIZING HYDROGEN BONDS</data>
  <data key="d1">REACTION_STEP</data>
  <data key="d2">Essential hydrogen-bonding interactions involving Ser120 and Ser121 that stabilize MVAP together with ATP during catalysis.</data>
  <data key="d3">0.8</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_8</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
<node id="GLN210">
  <data key="d0">GLN210</data>
  <data key="d1">RESIDUE</data>
  <data key="d2">A distant residue located on H4 that was identified as potentially altering substrate-binding modes for MVAP.</data>
  <data key="d3">0.68</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_8</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
<node id="ILE226">
  <data key="d0">ILE226</data>
  <data key="d1">RESIDUE</data>
  <data key="d2">A distant H4 residue identified as potentially affecting MVAP substrate-binding modes.</data>
  <data key="d3">0.68</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_8</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
<node id="VAL230">
  <data key="d0">VAL230</data>
  <data key="d1">RESIDUE</data>
  <data key="d2">A distant H4 residue identified as potentially affecting MVAP substrate-binding modes.</data>
  <data key="d3">0.68</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_8</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
