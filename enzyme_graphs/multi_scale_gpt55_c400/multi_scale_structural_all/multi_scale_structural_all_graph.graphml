  <data key="d0">TWO ACTIVE-SITE METAL-BINDING SITES</data>
  <data key="d1">POCKET_GEOMETRY</data>
  <data key="d2">Pair of metal-binding positions in the MDDEF active site, located between MVAPP and ADP-SO42− or related nucleotide-phosphate ligands; validated by cobalt anomalous signal.</data>
  <data key="d3">1.0</data>
  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_5</data>
  <data key="d5">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
</node>
