  <data key="d9">PRODUCT-RELEASE STEP</data>
  <data key="d10">ALLOWS</data>
  <data key="d11">Reversal of nucleotide-induced conformational changes is proposed to allow release of ADP and IPP after catalysis.</data>
  <data key="d12">0.64</data>
