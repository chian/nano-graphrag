  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_17</data>
  <data key="d5">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
</node>
<node id="ADP">
  <data key="d0">ADP</data>
  <data key="d1">CONTEXT</data>
  <data key="d2">A nucleotide ligand present in the deposited MDD_EF-MVAPP-ADP-SO4^2--Co2+ crystallographic complex, representing a product-like nucleotide-bound state.</data>
  <data key="d3">0.72</data>
  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_17</data>
