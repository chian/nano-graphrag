  <data key="d8">ATC INDUCTION CONCENTRATION</data>
  <data key="d9">PMDSC EXPRESSION LEVEL</data>
  <data key="d10">DETERMINES</data>
  <data key="d11">aTc concentration controls PMDsc expression level, with 10 nM maintaining stronger sensitivity and 100 nM reducing variant discrimination.</data>
  <data key="d12">0.85</data>
  <data key="d13">1</data>
  <data key="d14">8b12a598-340d-5340-aebf-b31ea016d294_chunk_3</data>
  <data key="d15">8b12a598-340d-5340-aebf-b31ea016d294</data>
</edge>
