  <data key="d8">SINGLE AMINO ACID MUTATION</data>
  <data key="d9">DECARBOXYLASE ACTIVITY</data>
  <data key="d10">SHIFTS</data>
  <data key="d11">The mutation shifts the enzyme away from its native decarboxylase outcome toward kinase-like phosphoryl-transfer activity.</data>
  <data key="d12">0.86</data>
  <data key="d13">1</data>
  <data key="d14">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_17</data>
  <data key="d15">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
</edge>
