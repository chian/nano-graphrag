  <data key="d1">EVIDENCE</data>
  <data key="d2">Reference [1], reporting a synthetic pathway for production of five-carbon alcohols from isopentenyl diphosphate.</data>
  <data key="d3">0.72</data>
  <data key="d4">dd599823-57fe-59b5-bf71-6ef7c22b4a8a_chunk_13</data>
