<node id="KINASE ACTIVITY">
  <data key="d0">KINASE ACTIVITY</data>
  <data key="d1">REACTION_STEP</data>
  <data key="d2">An alternative phosphoryl-transfer activity reported in the cited literature when a single amino acid mutation converts diphosphomevalonate decarboxylase into a kinase-like enzyme.</data>
  <data key="d3">0.8</data>
  <data key="d4">701d8434-7f71-5da9-bb94-e869d94e65fe_chunk_17</data>
  <data key="d5">701d8434-7f71-5da9-bb94-e869d94e65fe</data>
