  <data key="d0">CONSERVED P-LOOP MOTIF</data>
  <data key="d1">MOTIF</data>
  <data key="d2">Conserved motif in diphosphate decarboxylases that closes upon ATP binding and helps coordinate substrate and cofactor for catalysis.</data>
  <data key="d3">0.9</data>
  <data key="d4">8b12a598-340d-5340-aebf-b31ea016d294_chunk_9</data>
  <data key="d5">8b12a598-340d-5340-aebf-b31ea016d294</data>
</node>
